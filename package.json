{
  "name": "tsover-mono",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "test": "pnpm run check && pnpm -r test",
    "check": "oxlint . && oxfmt packages apps scripts --check",
    "fix": "oxlint . --fix && oxfmt packages apps scripts"
  },
  "devDependencies": {
    "@types/bun": "^1.3.8",
    "bun": "^1.3.13",
    "oxfmt": "^0.43.0",
    "oxlint": "^1.58.0",
    "pkg-pr-new": "^0.0.75"
  },
  "packageManager": "pnpm@10.33.4+sha512.1c67b3b359b2d408119ba1ed289f34b8fc3c6873412bec6fd264fbdc82489e510fcbecb9ce9d22dae7f3b76269d8441046014bdca53b9979cd7a561ad631b800",
  "pnpm": {
    "overrides": {
      "fumadocs-twoslash>typescript": "workspace:tsover@*"
    },
    "onlyBuiltDependencies": [
      "bun",
      "esbuild",
      "sharp"
    ]
  }
}
